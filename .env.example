# ── Public site URL (used for sitemap, canonical URLs and email links)
NEXT_PUBLIC_SITE_URL=https://www.somnyxsolar.com

# ── Database (Turso / libSQL). Leave unset locally to use ./storage/somnyx.db
# Production on Vercel REQUIRES a persistent database: create one at turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Admin access (all three required — admin stays locked until they are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ── Email notifications via Resend (resend.com). Without these, enquiries are
#    still saved to the database and the admin dashboard flags that email is off.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend
EMAIL_FROM="Somnyx Solar <no-reply@somnyxsolar.com>"
RFQ_NOTIFY_TO=sales@somnyxsolar.com
PROCUREMENT_NOTIFY_TO=procurement@somnyxsolar.com
TECHNICAL_NOTIFY_TO=technical@somnyxsolar.com

# ── File storage (Vercel Blob). Required in production for uploads
#    (RFQ attachments, datasheets, images, 3D models). Locally files go to ./storage
BLOB_READ_WRITE_TOKEN=

# ── Analytics (optional). Plausible domain, e.g. somnyxsolar.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
